      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"Projets\"><button role=\"tab\" aria-selected=\"true\">2023 Gustave Motors</button><button role=\"tab\" aria-selected=\"false\">2024 A-BOT</button></div>",
      "css": ".ds-tabs{display:flex;gap:5px;width:fit-content;padding:5px;border-radius:100px;background:var(--soft,#eceee9)}.ds-tabs button{border:0;border-radius:100px;padding:12px 23px;min-height:46px;background:none;color:var(--muted,#626a60);font:600 13px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;cursor:pointer}.ds-tabs button[aria-selected=\"true\"]{background:var(--surface,#fff);color:var(--text,#20271f);box-shadow:0 3px 10px #15291a0c}.ds-tabs button:hover{color:var(--text,#20271f)}.ds-tabs button:active{transform:scale(.96)}.ds-tabs button:focus-visible{outline:3px solid var(--accent,#34683f);outline-offset:5px}"

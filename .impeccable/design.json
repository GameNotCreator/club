      "css": ".ds-filter{background:none;border:1px solid transparent;border-radius:100px;padding:10px 17px;min-height:44px;color:var(--muted,#626a60);font:12px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;cursor:pointer;transition:background .2s,color .2s}.ds-filter[aria-pressed=\"true\"]{background:var(--text,#20271f);color:var(--bg,#f7f8f5)}.ds-filter:hover{background:var(--soft,#eceee9);color:var(--text,#20271f)}.ds-filter:active{transform:scale(.96)}.ds-filter:focus-visible{outline:3px solid var(--accent,#34683f);outline-offset:5px}"

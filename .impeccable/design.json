  "components": [
    {
      "name": "Lien principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Action externe principale, au contraste fort.",
      "html": "<a class=\"ds-primary\" href=\"#instagram\">@club.ingelgf <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M6 18 18 6M6 6h12v12\"/></svg></a>",
      "css": ".ds-primary{display:inline-flex;align-items:center;gap:28px;background:#294d32;color:#fff;padding:16px 24px;border-radius:100px;font:14px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;text-decoration:none;transition:background .2s,transform .2s}.ds-primary:hover{background:#34683f}.ds-primary:active{transform:scale(.96)}.ds-primary:focus-visible{outline:3px solid var(--accent,#34683f);outline-offset:5px}"
    },
    {
      "name": "Bouton icone",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Commande de theme ou de visionneuse.",
      "html": "<button class=\"ds-icon\" aria-label=\"Fermer\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"m6 6 12 12M6 18 18 6\"/></svg></button>",
      "css": ".ds-icon{display:grid;place-items:center;width:44px;height:44px;border:0;border-radius:50%;background:transparent;color:var(--text,#20271f);cursor:pointer;transition:background .2s,transform .2s}.ds-icon:hover{background:var(--soft,#eceee9)}.ds-icon:active{transform:scale(.96)}.ds-icon:focus-visible{outline:3px solid var(--accent,#34683f);outline-offset:5px}"
    },
    {
